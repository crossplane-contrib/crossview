server:
  port: 3001
  contextAliases:
    kind-kind: KIND
    shared-cluster: SHRD
  managed:
    cacheTTLSeconds: 300
    pageSize: 1000
    maxItemsPerType: 5000
    maxConcurrency: 10
  auth:
    mode: "header"
    header:
      trustedHeader: "X-Auth-User"
      createUsers: true
      defaultRole: "viewer"
  log:
    level: info
  cors:
    origin: http://localhost:3001
    credentials: true
    
vite:
  server:
    proxy:
      api:
        target: http://localhost:3001
        changeOrigin: true

